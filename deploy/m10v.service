[Unit]
Description=M10V firmware studio
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/m10v
ExecStart=/usr/local/bin/m10v-node node/server.mjs
Environment=NODE_ENV=production
Environment=M10V_PORT=3000
Environment=M10V_PUBLIC_ORIGIN=https://m10v.izhaoo.com
Environment=M10V_NO_BROWSER=1
Environment=M10V_LLVM_CLANG=/usr/bin/clang
Environment=M10V_PYTHON=/www/wwwroot/m10v/.venv/bin/python
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
